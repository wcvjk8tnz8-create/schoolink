# 复制为 .dev.vars 后填值（wrangler dev 会读取；.dev.vars 已在 .gitignore）
# 正式部署请填 GitHub → Settings → Secrets and variables → Actions

# 必填：固定随机串，换掉 = 所有人被登出。可用 `openssl rand -hex 32` 生成
SESSION_SECRET=replace-with-a-long-random-string

# 必填：/admin 后台登录密码
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# 可选：邮件 API（也可以部署后到 /admin 网页填，优先级更高）
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Schoolink <onboarding@resend.dev>
