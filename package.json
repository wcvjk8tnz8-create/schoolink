{
  "name": "schoolink",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Schoolink — campus chat on Cloudflare Workers, built with Next.js + TypeScript",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check": "python3 scripts/selfcheck.py",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --config wrangler.jsonc worker/env.d.ts"
  },
  "dependencies": {
    "motion": "14.13.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "@types/node": "^22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "wrangler": "4.161.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
