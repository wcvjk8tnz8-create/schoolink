// ─────────────────────────────────────────────────────────────────────
// 本地开发模板。正式部署走 GitHub Actions：
//   Actions → Deploy Schoolink → 填 Secrets / Variables → Run workflow
// scripts/provision.mjs 会在 CI 里覆写本档，自动建立并回填 D1 / KV / R2 的真实 ID。
// 不需要 R2 时把 Variable ENABLE_R2 设为 false：脚本不会建立 bucket，也不会写入绑定。
// Durable Object 由 wrangler deploy 依据 migrations 自动建立，无需 API 预建。
// ─────────────────────────────────────────────────────────────────────
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schoolink",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/api", "/admin", "/admin/"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "schoolink-db", "database_id": "REPLACE_WITH_D1_ID" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "REPLACE_WITH_KV_ID" }
  ],
  "r2_buckets": [
    { "binding": "IMAGES", "bucket_name": "schoolink-images" }
  ],
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "REALTIME", "class_name": "RealtimeHub" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }
  ],
  "vars": {
    "ALLOWED_EMAIL_DOMAINS": "@plkshs.edu.hk",
    "ADMIN_EMAILS": "admin@plkshs.edu.hk",
    "SCHOOL_NAME": "保良局蕭漢森小學",
    "ALLOW_DEV_OTP": "0",
    "REQUIRE_BOUND_EMAIL": "0",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "AI_ALLOW_USER_MODEL": "1",
    "R2_PUBLIC_BASE_URL": ""
  }
}
